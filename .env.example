# Harness configuration. Copy to ~/.harness/.env (or to .env in this repository) and fill in.
# Precedence, highest first:
#   runAgent options / CLI flags  >  environment variables  >  ~/.harness/.env  >  repo .env  >  defaults
# Invalid values (non-numeric, out of range) stop the harness with an error; they are never ignored.

# --- Required ---
# OpenAI API key.
OPENAI_API_KEY=sk-your-key-here
# Main model for the agent.
OPENAI_MODEL=gpt-4.1-mini

# --- Optional (the values shown are the defaults) ---
# Context window budget in tokens (integer, 2000 or more).
CONTEXT_LIMIT=100000
# Share of CONTEXT_LIMIT at which compaction starts (0.1 to 0.95).
COMPACT_THRESHOLD=0.7
# Tokens of the most recent tool results kept in full by compaction (1 to CONTEXT_LIMIT; default 40% of CONTEXT_LIMIT).
# RECENT_BUDGET=40000
# Model for compaction calls (file descriptions and summaries); empty = same as OPENAI_MODEL.
# COMPACT_MODEL=gpt-4.1-nano
# Ask the model once to cover unread files before accepting a whole-project answer (on/off).
COVERAGE_CHECK=on
# Append the harness-computed coverage footer to final answers (on/off).
COVERAGE_FOOTER=on
# Maximum agent steps per task (1 to 500).
MAX_STEPS=20
